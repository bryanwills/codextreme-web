---
interface Props {
  size?: number;
  variant?: "mark" | "full";
  withWordmark?: boolean;
}
const { size = 32 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="#BFFF00"/>
  <text x="50%" y="53%" dominant-baseline="middle" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-weight="800" font-size="13" letter-spacing="-0.06em" fill="#07080B">CX</text>
</svg>
