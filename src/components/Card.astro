---
const { title, description, borderColor, icon, eyebrow, meta } = Astro.props;
// borderColor kept for compatibility but mapped to subtle neutral; we don't use colored left border per craft floor
---

<div class="group relative flex flex-col h-full rounded-[16px] bg-[#111318] border border-[#232730] p-6 overflow-hidden hover:border-[#2D3340] transition-colors">
  <!-- subtle inner highlight -->
  <div class="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: radial-gradient(600px circle at 0% 0%, rgba(191,255,0,0.06), transparent 60%);"></div>

  <div class="relative flex flex-col h-full">
    {(eyebrow || meta) && (
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-[11px] tracking-[0.12em] font-medium text-[#61697E] uppercase">{eyebrow || meta}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#BFFF00] opacity-80"></span>
      </div>
    )}

    <div class="w-10 h-10 rounded-[12px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-5 group-hover:border-[#2D3340] transition-colors">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d={icon}></path>
      </svg>
    </div>

    <h3 class="font-[--font-display] font-semibold text-[18px] leading-[1.2] tracking-[-0.02em] text-white mb-2">
      {title}
    </h3>

    <p class="text-[13.5px] leading-relaxed text-[#8B92A8]">
      {description}
    </p>

    <div class="mt-auto pt-4 flex items-center gap-2 font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase opacity-0 group-hover:opacity-100 transition-opacity">
      <span>Bench verified</span>
      <span class="w-4 h-px bg-[#232730]"></span>
    </div>
  </div>
</div>
