---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languageList } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import BrandLogo from "@/components/BrandLogo.astro";

const getPathWithoutLocale = (path: string): string => {
  const segments = path.split("/").filter(Boolean);
  const isLocaleSegment = ["en", "es"].includes(segments[0]);
  const pathWithoutLocale = isLocaleSegment
    ? segments.slice(1).join("/")
    : segments.join("/");
  return pathWithoutLocale || "/";
};

const currentPathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const currentLang = Astro.currentLocale || "en";
const t = useTranslations(currentLang as keyof typeof languageList);

const navLinks = [
  { href: getRelativeLocaleUrl(currentLang, "/"), label: t("nav.home") },
  { href: getRelativeLocaleUrl(currentLang, "guias"), label: t("nav.guides") },
  {
    href: getRelativeLocaleUrl(currentLang, "herramientas"),
    label: t("nav.tools"),
  },
  {
    href: getRelativeLocaleUrl(currentLang, "software"),
    label: t("nav.software"),
  },
  {
    href: getRelativeLocaleUrl(currentLang, "descargas"),
    label: t("nav.download"),
  },
  {
    href: getRelativeLocaleUrl(currentLang, "optimizer"),
    label: t("nav.optimizer"),
  },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-[#232730] bg-[#07080B]/85 backdrop-blur-[14px]"
>
  <div
    class="max-w-[1280px] mx-auto px-4 md:px-6 h-[64px] flex items-center justify-between gap-4"
  >
    <!-- Brand -->
    <a
      href={getRelativeLocaleUrl(currentLang, "/")}
      class="flex items-center gap-3 shrink-0 group"
    >
      <BrandLogo size={36} variant="mark" />
      <div class="flex flex-col leading-none">
        <span
          class="font-[--font-display] font-bold text-[17px] tracking-[-0.02em] text-white"
          >CodeXtremeOS</span
        >
        <span
          class="font-mono text-[10px] tracking-[0.12em] text-[#8B92A8] flex items-center gap-1.5"
        >
          <span class="w-[6px] h-[6px] rounded-full bg-[#BFFF00]"></span>
          BUILD 25H2 — LIVE
        </span>
      </div>
    </a>

    <!-- Center nav pill - desktop -->
    <nav class="hidden lg:flex items-center">
      <div
        class="flex items-center gap-1 p-1 rounded-full bg-[#111318] border border-[#232730]"
      >
        {
          navLinks.map((link) => {
            const isActive =
              Astro.url.pathname === link.href ||
              (link.href !== getRelativeLocaleUrl(currentLang, "/") &&
                Astro.url.pathname.includes(link.href.replace(/\/$/, "")));
            return (
              <a
                href={link.href}
                class={`px-3.5 py-[7px] rounded-full text-[13px] font-medium tracking-[-0.01em] transition-colors ${isActive ? "bg-white text-black" : "text-[#8B92A8] hover:text-white hover:bg-white/[0.06]"}`}
              >
                {link.label}
              </a>
            );
          })
        }
      </div>
    </nav>

    <!-- Right -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Lang -->
      <div class="relative group/lang">
        <button
          class="h-9 px-3 rounded-full bg-[#111318] border border-[#232730] text-[13px] font-mono font-medium text-[#8B92A8] hover:text-white hover:border-[#2D3340] transition-colors flex items-center gap-2"
          aria-label={t("aria.language_switch")}
        >
          <span class="uppercase">{currentLang}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
            ><path
              d="M4 6l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </button>
        <div
          class="absolute right-0 top-full mt-2 w-36 rounded-2xl bg-[#111318] border border-[#232730] p-1 opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all z-50 overflow-hidden"
        >
          {
            Object.entries(languageList).map(
              ([code, name]) =>
                code !== currentLang && (
                  <a
                    href={getRelativeLocaleUrl(
                      code as any,
                      currentPathWithoutLocale,
                    )}
                    class="block px-3 py-2 rounded-xl text-[13px] text-[#8B92A8] hover:text-white hover:bg-white/[0.06] transition-colors"
                  >
                    {name}
                  </a>
                ),
            )
          }
        </div>
      </div>

      <!-- Theme -->
      <button
        id="theme-toggle"
        class="w-9 h-9 rounded-full bg-[#111318] border border-[#232730] hover:border-[#2D3340] flex items-center justify-center text-[#8B92A8] hover:text-white transition-colors"
        aria-label={t("theme.toggle")}
      >
        <span id="theme-icon" class="text-[14px]">☾</span>
      </button>

      <!-- CTA -->
      <a
        href={getRelativeLocaleUrl(currentLang, "descargas")}
        class="hidden md:inline-flex items-center gap-2 h-9 px-5 rounded-full bg-[#BFFF00] text-black text-[13px] font-semibold tracking-[-0.01em] hover:bg-[#D4FF4D] transition-colors"
      >
        {t("header.download_cta")}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
          ><path
            d="M8 3v9M4 8l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>

      <!-- Mobile menu btn -->
      <button
        id="mobile-menu-button"
        class="lg:hidden w-9 h-9 rounded-full bg-[#111318] border border-[#232730] flex items-center justify-center text-white"
        aria-label={t("aria.open_menu")}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          ><path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path></svg
        >
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-[#232730] bg-[#07080B]"
  >
    <div class="px-4 py-4 flex flex-wrap gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 rounded-full bg-[#111318] border border-[#232730] text-[13px] font-medium text-[#8B92A8] hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={getRelativeLocaleUrl(currentLang, "descargas")}
        class="px-4 py-2 rounded-full bg-[#BFFF00] text-black text-[13px] font-semibold"
        >Descargar</a
      >
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById("theme-toggle");
  const themeIcon = document.getElementById("theme-icon");
  const html = document.documentElement;

  const isLight = localStorage.getItem("theme") === "light";
  if (isLight) {
    html.classList.remove("dark");
    html.classList.add("light");
    document.body.classList.remove("bg-[#07080B]", "text-[#F2F3F5]");
    document.body.classList.add("bg-[#F8F9FA]", "text-[#111318]");
    themeIcon.textContent = "☀";
  } else {
    html.classList.add("dark");
    themeIcon.textContent = "☾";
  }

  themeToggle?.addEventListener("click", () => {
    const isDark = html.classList.contains("dark");
    if (isDark) {
      html.classList.remove("dark");
      html.classList.add("light");
      document.body.classList.remove("bg-[#07080B]", "text-[#F2F3F5]");
      document.body.classList.add("bg-[#F8F9FA]", "text-[#111318]");
      themeIcon.textContent = "☀";
      localStorage.setItem("theme", "light");
    } else {
      html.classList.add("dark");
      html.classList.remove("light");
      document.body.classList.add("bg-[#07080B]", "text-[#F2F3F5]");
      document.body.classList.remove("bg-[#F8F9FA]", "text-[#111318]");
      themeIcon.textContent = "☾";
      localStorage.setItem("theme", "dark");
    }
  });

  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    menu?.classList.toggle("hidden");
  });
  document.addEventListener("click", (e) => {
    if (!menu?.contains(e.target) && !btn?.contains(e.target))
      menu?.classList.add("hidden");
  });
</script>
