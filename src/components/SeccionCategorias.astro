---
import ToolCard from "@/components/TarjetaTools.astro";
const { title, tools, borderColor } = Astro.props;
---

<div class="rounded-[16px] bg-[#111318] border border-[#232730] p-5">
  <div class="flex items-center gap-3 mb-5">
    <span class="w-1.5 h-6 rounded-full bg-[#BFFF00]"></span>
    <h2 class="font-[--font-display] font-semibold text-[16px] tracking-[-0.01em] text-white">{title}</h2>
  </div>
  <div class="space-y-3">
    {tools.map((tool: any) => (
      <ToolCard {...tool} />
    ))}
  </div>
</div>
