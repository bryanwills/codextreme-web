---
const { title, description, tags, link, linkText } = Astro.props;
---

<div class="group rounded-[14px] bg-[#0D0F13] border border-[#232730] p-4 hover:border-[#2D3340] transition-colors flex flex-col">
  <h3 class="font-semibold text-[14px] leading-tight text-white group-hover:text-[#BFFF00] transition-colors">{title}</h3>
  <p class="mt-1.5 text-[12.5px] leading-relaxed text-[#8B92A8] flex-grow">{description}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag: any) => (
      <span class="px-2 py-1 rounded-full text-[10px] font-mono tracking-[0.06em] bg-[#111318] border border-[#232730] text-[#61697E]">{tag.label}</span>
    ))}
  </div>
  <a href={link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center justify-center gap-2 h-8 rounded-full bg-white text-black text-[12px] font-semibold hover:bg-[#EFEFEF] transition-colors">
    {linkText} <span>↗</span>
  </a>
</div>
