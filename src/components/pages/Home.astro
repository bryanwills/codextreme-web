---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/Card.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { languageList } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: keyof typeof languageList;
}

const { lang } = Astro.props;
const currentLang = lang;
const t = useTranslations(lang);
---

<BaseLayout>
  <!-- HERO BENCH -->
  <section class="relative overflow-hidden">
    <div class="max-w-[1280px] mx-auto px-4 md:px-6 pt-8 md:pt-14 pb-10">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 lg:gap-6 items-start">
        <!-- Left copy -->
        <div class="pt-2">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-[#232730] bg-[#111318] px-3 py-1.5 mb-6"
          >
            <span class="w-2 h-2 rounded-full bg-[#BFFF00]"></span>
            <span
              class="font-mono text-[11px] tracking-[0.12em] font-medium text-[#8B92A8] uppercase"
              >NTLite build · 25H2 · Verified bench</span
            >
            <span class="hidden sm:inline font-mono text-[11px] text-[#61697E]"
              >— stock 18.4 GB → CX 8.1 GB</span
            >
          </div>

          <h1
            class="font-[--font-display] font-bold tracking-[-0.04em] leading-[0.9] text-white"
          >
            <span class="block text-[42px] md:text-[64px] lg:text-[72px]"
              >Windows</span
            >
            <span class="block text-[42px] md:text-[64px] lg:text-[72px]"
              >{t("home.hero.line2")}</span
            >
            <span
              class="block text-[42px] md:text-[64px] lg:text-[72px] text-[#8B92A8]"
              >{t("home.hero.line3")}</span
            >
          </h1>

          <p
            class="mt-6 text-[18px] md:text-[20px] leading-relaxed text-[#8B92A8] max-w-[48ch]"
          >
            {t("home.description")}
            {t("home.hero.sub")}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={getAbsoluteLocaleUrl(currentLang, "descargas")}
              class="inline-flex items-center gap-2 h-11 px-6 rounded-full bg-[#BFFF00] text-black text-[14px] font-semibold tracking-[-0.01em] hover:bg-[#D4FF4D] transition-colors"
            >
              {t("download.button")}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M8 3v9M4 8l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            <a
              href={getAbsoluteLocaleUrl(currentLang, "guias")}
              class="inline-flex items-center gap-2 h-11 px-6 rounded-full bg-[#111318] border border-[#232730] text-white text-[14px] font-medium hover:border-[#2D3340] hover:bg-[#171A21] transition-colors"
            >
              {t("home.hero.cta_guides")}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>

          <div
            class="mt-6 flex items-center gap-3 font-mono text-[11px] tracking-[0.06em] text-[#61697E]"
          >
            <span class="flex items-center gap-1.5"
              ><span class="w-1 h-1 rounded-full bg-[#8B92A8]"></span> XOscarDevX</span
            >
            <span>·</span>
            <span>Open source</span>
            <span>·</span>
            <a
              href="https://github.com/CodeF1ow/codextreme-web"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-[#232730] underline-offset-4 hover:text-[#8B92A8]"
              >GitHub</a
            >
          </div>
        </div>

        <!-- Right bench panel -->
        <div
          class="relative rounded-[20px] bg-[#111318] border border-[#232730] overflow-hidden"
        >
          <!-- window header -->
          <div
            class="h-11 flex items-center justify-between px-4 border-b border-[#232730] bg-[#0D0F13]"
          >
            <div class="flex items-center gap-2">
              <span class="flex gap-1.5">
                <span class="w-3 h-3 rounded-full bg-[#2A2E38]"></span>
                <span class="w-3 h-3 rounded-full bg-[#2A2E38]"></span>
                <span class="w-3 h-3 rounded-full bg-[#BFFF00]"></span>
              </span>
              <span
                class="ml-3 font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase hidden sm:inline"
                >bench — CodeXtreme_25H2 vs Stock_24H2</span
              >
              <span
                class="ml-3 font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase sm:hidden"
                >bench — live</span
              >
            </div>
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-[#BFFF00]/10 border border-[#BFFF00]/20 px-2.5 py-1 font-mono text-[10px] tracking-[0.08em] font-semibold text-[#BFFF00]"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-[#BFFF00] animate-[pulse-live_1.2s_ease-in-out_infinite]"
              ></span> LIVE BENCH
            </span>
          </div>

          <div class="p-5 md:p-6 space-y-6">
            <!-- Comparison bars -->
            <div class="grid grid-cols-3 gap-4">
              <div>
                <div
                  class="font-mono text-[10px] tracking-[0.12em] text-[#61697E] uppercase mb-2"
                >
                  ISO size
                </div>
                <div class="space-y-2">
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#8B92A8]">Stock</span><span
                      class="text-white">18.4 GB</span
                    >
                  </div>
                  <div
                    class="h-2 rounded-full bg-[#0D0F13] border border-[#232730] overflow-hidden"
                  >
                    <div class="h-full w-[92%] bg-[#2A2E38]"></div>
                  </div>
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#BFFF00]">CodeXtreme</span><span
                      class="text-white">5.0 GB</span
                    >
                  </div>
                  <div class="h-2 rounded-full bg-[#BFFF00]"></div>
                </div>
              </div>
              <div>
                <div
                  class="font-mono text-[10px] tracking-[0.12em] text-[#61697E] uppercase mb-2"
                >
                  Idle RAM
                </div>
                <div class="space-y-2">
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#8B92A8]">Stock</span><span
                      class="text-white">2.8 GB</span
                    >
                  </div>
                  <div
                    class="h-2 rounded-full bg-[#0D0F13] border border-[#232730] overflow-hidden"
                  >
                    <div class="h-full w-[78%] bg-[#2A2E38]"></div>
                  </div>
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#BFFF00]">CodeXtreme</span><span
                      class="text-white">1.4 GB</span
                    >
                  </div>
                  <div class="h-2 rounded-full bg-[#BFFF00] w-[50%]"></div>
                </div>
              </div>
              <div>
                <div
                  class="font-mono text-[10px] tracking-[0.12em] text-[#61697E] uppercase mb-2"
                >
                  Cold boot
                </div>
                <div class="space-y-2">
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#8B92A8]">Stock</span><span
                      class="text-white">28.7s</span
                    >
                  </div>
                  <div
                    class="h-2 rounded-full bg-[#0D0F13] border border-[#232730] overflow-hidden"
                  >
                    <div class="h-full w-[86%] bg-[#2A2E38]"></div>
                  </div>
                  <div
                    class="flex items-center justify-between font-mono text-[11px]"
                  >
                    <span class="text-[#BFFF00]">CodeXtreme</span><span
                      class="text-white">12.3s</span
                    >
                  </div>
                  <div class="h-2 rounded-full bg-[#BFFF00] w-[43%]"></div>
                </div>
              </div>
            </div>

            <!-- Sparkline FPS -->
            <div
              class="rounded-[14px] bg-[#0D0F13] border border-[#232730] p-4"
            >
              <div class="flex items-center justify-between mb-3">
                <span
                  class="font-mono text-[11px] tracking-[0.08em] text-[#8B92A8] uppercase"
                  >FPS — Valorant 1080p Low (bench 3 runs)</span
                >
                <span class="font-mono text-[11px] font-semibold text-[#BFFF00]"
                  >+18% avg</span
                >
              </div>
              <svg viewBox="0 0 320 60" class="w-full h-[56px]">
                <path
                  d="M0 45 C 20 42, 40 48, 60 36 S 100 18, 130 22 S 180 38, 210 30 S 260 12, 320 16"
                  fill="none"
                  stroke="#2A2E38"
                  stroke-width="2"
                  stroke-dasharray="4 4"></path>
                <path
                  d="M0 48 C 20 44, 40 40, 60 28 S 100 8, 130 12 S 180 24, 210 18 S 260 6, 320 4"
                  fill="none"
                  stroke="#BFFF00"
                  stroke-width="2"></path>
              </svg>
              <div
                class="flex justify-between font-mono text-[10px] text-[#61697E] mt-1"
              >
                <span>Stock 212 fps</span><span>CX 251 fps</span>
              </div>
            </div>

            <!-- Striker list -->
            <div class="space-y-2.5">
              <div
                class="font-mono text-[11px] tracking-[0.12em] text-[#61697E] uppercase"
              >
                Removed — verified line
              </div>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-mono text-[12px]"
              >
                <span class="flex items-center gap-2 text-[#61697E]"
                  ><span class="line-through decoration-[#FF3344]/60"
                    >Cortana</span
                  >
                  <span class="text-[#BFFF00]">—</span></span
                >
                <span class="flex items-center gap-2 text-[#61697E]"
                  ><span class="line-through decoration-[#FF3344]/60"
                    >OneDrive pre</span
                  >
                  <span class="text-[#BFFF00]">—</span></span
                >
                <span class="flex items-center gap-2 text-[#61697E]"
                  ><span class="line-through decoration-[#FF3344]/60"
                    >Telemetry diag</span
                  >
                  <span class="text-[#BFFF00]">—</span></span
                >
                <span class="flex items-center gap-2 text-[#8B92A8]"
                  >Xbox <span class="text-[#8B92A8] font-semibold">keep</span> · Store
                  installer in</span
                >
              </div>
            </div>

            <div
              class="flex items-center gap-2 pt-2 border-t border-[#232730] font-mono text-[11px] text-[#61697E]"
            >
              <span class="w-2 h-2 rounded-full bg-[#BFFF00]"></span>
              Tested on 24H2 — WinUtil on desktop · drivers Intel RST · no internet
              required for install
            </div>
          </div>
        </div>
      </div>

      <!-- Proof strip -->
      <div
        class="mt-8 rounded-full bg-[#111318] border border-[#232730] px-4 py-3 flex flex-wrap gap-x-6 gap-y-2 justify-center font-mono text-[11px] tracking-[0.06em] text-[#8B92A8]"
      >
        <span><b class="text-white font-semibold">12.3s</b> boot</span>
        <span class="hidden sm:inline text-[#232730]">·</span>
        <span><b class="text-white font-semibold">1.4 GB</b> idle</span>
        <span class="hidden sm:inline text-[#232730]">·</span>
        <span><b class="text-white font-semibold">5 GB</b> ISO</span>
        <span class="hidden sm:inline text-[#232730]">·</span>
        <span
          ><b class="text-white font-semibold">{t("home.proof.no")}</b>
          {t("home.proof.telemetry")}</span
        >
        <span class="hidden sm:inline text-[#232730]">·</span>
        <span class="text-[#BFFF00]">UWP / Xbox / WSL2 compatibles</span>
      </div>
    </div>
  </section>

  {/* QUÉ ES — BENTO */}
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 py-10 md:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <h2
        class="font-[--font-display] font-semibold text-[28px] md:text-[36px] tracking-[-0.03em] leading-none text-white"
      >
        {t("home.ques")}
      </h2>
      <span
        class="font-mono text-[11px] tracking-[0.12em] text-[#61697E] uppercase"
        >{t("home.section.about")}</span
      >
    </div>

    <div class="grid grid-cols-12 gap-4 md:gap-5">
      <!-- Large 1 -->
      <div class="col-span-12 lg:col-span-7">
        <Card
          title={t("home.opti")}
          description={t("home.desopti")}
          icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
          eyebrow={t("home.card.weight")}
        />
      </div>
      <div class="col-span-12 lg:col-span-5">
        <Card
          title={t("home.safety")}
          description={t("home.safe.des")}
          icon="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          eyebrow={t("home.card.security")}
        />
      </div>

      <div class="col-span-12 md:col-span-5">
        <Card
          title={t("home.update")}
          description={t("home.update.des")}
          icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          eyebrow="Bench 03 — Updates"
        />
      </div>
      <div class="col-span-12 md:col-span-7">
        <Card
          title={t("home.performance")}
          description={t("home.performance.des")}
          icon="M13 10V3L4 14h7v7l9-11h-7z"
          eyebrow="Bench 04 — Gaming"
        />
      </div>

      <div class="col-span-12 md:col-span-4">
        <Card
          title={t("home.drivers")}
          description={t("home.drivers.des")}
          icon="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
          eyebrow="Bench 05 — Drivers"
        />
      </div>
      <div class="col-span-12 md:col-span-4">
        <Card
          title={t("home.xbox")}
          description={t("home.xbox.des")}
          icon="M12 6v6m0 0v6m0-6h6m-6 0H6"
          eyebrow="Bench 06 — Xbox Live"
        />
      </div>
      <div class="col-span-12 md:col-span-4">
        <Card
          title={t("home.support")}
          description={t("home.support.des")}
          icon="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
          eyebrow={t("home.card.support")}
        />
      </div>

      <div class="col-span-12 md:col-span-6">
        <Card
          title={t("home.appearance")}
          description={t("home.appearance.des")}
          icon="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
          eyebrow={t("home.card.appearance")}
        />
      </div>
      <div class="col-span-12 md:col-span-6">
        <div
          class="h-full rounded-[16px] bg-[#BFFF00] p-6 md:p-7 flex flex-col justify-between text-black"
        >
          <div>
            <div
              class="font-mono text-[11px] tracking-[0.12em] font-semibold uppercase opacity-60"
            >
              {t("home.note.eyebrow")}
            </div>
            <h3
              class="mt-3 font-[--font-display] font-bold text-[22px] leading-tight tracking-[-0.02em]"
            >
              {t("home.note.title1")}<br />{t("home.note.title2")}
            </h3>
            <p class="mt-3 text-[14px] leading-relaxed opacity-75">
              {t("home.dev.des")}
            </p>
          </div>
          <a
            href="https://github.com/CodeF1ow/codextreme-web"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 font-mono text-[12px] font-semibold tracking-[0.04em]"
            >{t("home.note.cta")} <span>→</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES — TELEMETRY WALL -->
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 pb-10">
    <div
      class="rounded-[20px] bg-[#111318] border border-[#232730] overflow-hidden"
    >
      <div
        class="px-6 md:px-8 py-6 border-b border-[#232730] flex items-center justify-between"
      >
        <h2
          class="font-[--font-display] font-semibold text-[22px] md:text-[26px] tracking-[-0.02em] text-white"
        >
          {t("home.features")}
        </h2>
        <span
          class="font-mono text-[11px] tracking-[0.12em] text-[#61697E] uppercase hidden sm:inline"
          >Wall 02 — Spec</span
        >
      </div>
      <div
        class="grid md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-[#232730]"
      >
        <div class="p-6 md:p-7">
          <div
            class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="1.6"
              ><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
            >
          </div>
          <h3 class="font-semibold text-[15px] leading-tight text-white">
            {t("home.low")}
          </h3>
          <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("home.low.des")}
          </p>
          <div class="mt-4 font-mono text-[11px] text-[#BFFF00]">
            1.4 GB idle · -50%
          </div>
        </div>
        <div class="p-6 md:p-7">
          <div
            class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="1.6"
              ><rect x="3" y="4" width="18" height="14" rx="2"></rect><path
                d="M7 8h4M7 12h6M15 12h2"></path></svg
            >
          </div>
          <h3 class="font-semibold text-[15px] leading-tight text-white">
            {t("home.compatibility")}
          </h3>
          <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("home.compatibility.des")}
          </p>
          <div class="mt-4 font-mono text-[11px] text-[#8B92A8]">
            AAA + WS A/WSL2 OK
          </div>
        </div>
        <div class="p-6 md:p-7">
          <div
            class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="1.6"
              ><path d="M12 3l7 4v5c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V7l7-4z"
              ></path></svg
            >
          </div>
          <h3 class="font-semibold text-[15px] leading-tight text-white">
            {t("home.security")}
          </h3>
          <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("home.security.des")}
          </p>
          <div class="mt-4 font-mono text-[11px] text-[#8B92A8]">
            {t("home.wall.telemetry")}
          </div>
        </div>
        <div class="p-6 md:p-7">
          <div
            class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="1.6"
              ><path d="M12 20h9"></path><path d="M16 4l4 4-10 10H6v-4L16 4z"
              ></path></svg
            >
          </div>
          <h3 class="font-semibold text-[15px] leading-tight text-white">
            {t("home.personalization")}
          </h3>
          <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("home.personalization.des")}
          </p>
          <div class="mt-4 font-mono text-[11px] text-[#8B92A8]">
            Windhawk · StartAllBack
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NTLITE WORKSHOP -->
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 pb-10">
    <div
      class="rounded-[20px] border border-[#FFB020]/20 bg-[#FFB020]/[0.06] overflow-hidden"
    >
      <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-0">
        <div class="p-6 md:p-8">
          <div
            class="inline-flex items-center gap-2 rounded-full bg-[#FFB020] text-black px-3 py-1 font-mono text-[11px] font-bold tracking-[0.06em]"
          >
            WORKSHOP
          </div>
          <h3
            class="mt-4 font-[--font-display] font-semibold text-[20px] tracking-[-0.02em] text-white"
          >
            {t("home.workshop.title")}
          </h3>
          <p
            class="mt-3 text-[14px] leading-relaxed text-[#8B92A8] max-w-[52ch]"
          >
            {t("home.workshop.body1")}<a
