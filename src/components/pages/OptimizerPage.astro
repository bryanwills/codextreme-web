---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { languageList } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: keyof typeof languageList;
}

const { lang } = Astro.props;
const currentLang = lang;
const t = useTranslations(lang);
---

<BaseLayout title="CodeWin Optimizer — CodeXtremeOS">
  <!-- Hero - real tool -->
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 pt-8 md:pt-10">
    <div
      class="rounded-[20px] bg-[#111318] border border-[#232730] overflow-hidden"
    >
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-0">
        <div class="p-6 md:p-10">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-[#232730] bg-[#0D0F13] px-3 py-1.5 mb-5"
          >
            <span class="w-2 h-2 rounded-full bg-[#BFFF00]"></span>
            <span
              class="font-mono text-[11px] tracking-[0.1em] text-[#8B92A8] uppercase"
              >Portable · Open Source · Local-first</span
            >
            <span
              class="hidden sm:inline font-mono text-[10px] px-2 py-1 rounded-full bg-[#BFFF00] text-black font-bold"
              >v CodeWinOptimizer</span
            >
          </div>
          <h1
            class="font-[--font-display] font-bold text-[36px] md:text-[48px] tracking-[-0.03em] leading-[0.9] text-white"
          >
            {t("optimizer.hero.line1")}<br />
            <span class="text-[#8B92A8]">{t("optimizer.hero.line2")}</span>
          </h1>
          <p
            class="mt-4 text-[16px] leading-relaxed text-[#8B92A8] max-w-[52ch]"
          >
            {t("optimizer.hero.sub")}
          </p>

          <div
            class="mt-6 rounded-[14px] bg-[#0D0F13] border border-[#232730] p-4"
          >
            <div
              class="font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase mb-2"
            >
              {t("optimizer.install.label")}
            </div>
            <div
              class="flex items-center gap-2 rounded-[10px] bg-[#07080B] border border-[#232730] px-3 py-3 font-mono text-[12px] text-white overflow-x-auto"
            >
              <span class="text-[#61697E] select-none">$</span>
              <span class="whitespace-nowrap"
                >irm https://codewinoptimizer.com/win | iex</span
              >
              <button
                onclick="navigator.clipboard.writeText('irm https://codewinoptimizer.com/win | iex')"
                class="ml-auto shrink-0 inline-flex items-center justify-center h-7 px-3 rounded-full bg-white text-black text-[11px] font-semibold leading-none"
                >Copy</button
              >
            </div>
            <p class="mt-2 font-mono text-[11px] text-[#61697E]">
              {t("optimizer.install.note")}
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://github.com/oscarxdev/CodeWinOptimizer-App/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 h-11 px-6 rounded-full bg-[#BFFF00] text-black text-[14px] font-semibold hover:bg-[#D4FF4D] transition-colors"
            >
              {t("optimizer.cta.download")}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M8 3v9M4 8l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            <a
              href="https://github.com/oscarxdev/CodeWinOptimizer-App"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 h-11 px-6 rounded-full bg-[#0D0F13] border border-[#232730] text-white text-[14px] font-medium hover:border-[#2D3340] transition-colors"
            >
              {t("optimizer.cta.github")}
            </a>
            <a
              href="https://www.codewinoptimizer.com/docs"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center h-11 px-6 rounded-full bg-[#111318] border border-[#232730] text-[#8B92A8] text-[14px] font-medium hover:text-white transition-colors"
              >Docs →</a
            >
          </div>

          <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px]">
            <span
              class="px-3 py-1.5 rounded-full bg-[#0D0F13] border border-[#232730] text-[#8B92A8]"
              >Windows 10/11</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-[#0D0F13] border border-[#232730] text-[#8B92A8]"
              >WebView2 · Single .exe</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-[#0D0F13] border border-[#232730] text-[#8B92A8]"
              >O&O ShutUp10++ bundled</span
            >
          </div>
        </div>

        <div
          class="p-6 md:p-6 bg-[#0D0F13] border-t lg:border-t-0 lg:border-l border-[#232730] flex flex-col gap-4"
        >
          <div class="rounded-[14px] bg-[#111318] border border-[#232730] p-4">
            <div
              class="font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase"
            >
              {t("optimizer.numbers.label")}
            </div>
            <div class="mt-3 grid grid-cols-3 gap-3">
              <div
                class="rounded-[12px] bg-[#07080B] border border-[#232730] p-3 text-center"
              >
                <div
                  class="font-[--font-display] font-bold text-[22px] leading-none text-white"
                >
                  181
                </div><div
                  class="mt-1 font-mono text-[10px] text-[#61697E] uppercase"
                >
                  Apps
                </div>
              </div>
              <div
                class="rounded-[12px] bg-[#07080B] border border-[#232730] p-3 text-center"
              >
                <div
                  class="font-[--font-display] font-bold text-[22px] leading-none text-[#BFFF00]"
                >
                  140+
                </div><div
                  class="mt-1 font-mono text-[10px] text-[#61697E] uppercase"
                >
                  Tweaks
                </div>
              </div>
              <div
                class="rounded-[12px] bg-[#07080B] border border-[#232730] p-3 text-center"
              >
                <div
                  class="font-[--font-display] font-bold text-[22px] leading-none text-white"
                >
                  14
                </div><div
                  class="mt-1 font-mono text-[10px] text-[#61697E] uppercase"
                >
                  {t("optimizer.numbers.categories")}
                </div>
              </div>
            </div>
            <div
              class="mt-3 grid grid-cols-3 gap-3 text-center font-mono text-[11px]"
            >
              <div
                class="py-2 rounded-full bg-[#111318] border border-[#232730] text-[#8B92A8]"
              >
                2 managers
              </div>
              <div
                class="py-2 rounded-full bg-[#111318] border border-[#232730] text-[#8B92A8]"
              >
                6 accents
              </div>
              <div
                class="py-2 rounded-full bg-[#111318] border border-[#232730] text-[#8B92A8]"
              >
                1 .exe
              </div>
            </div>
          </div>
          <div
            class="rounded-[14px] border border-[#BFFF00]/20 bg-[#BFFF00]/[0.06] p-4"
          >
            <div
              class="font-mono text-[11px] font-semibold text-[#BFFF00] uppercase"
            >
              {t("optimizer.old.title")}
            </div>
            <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
              {t("optimizer.old.body1")}<b class="text-white"
                >{t("optimizer.old.emphasis")}</b
              >{t("optimizer.old.body2")}
            </p>
            <a
              href="https://www.codewinoptimizer.com"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex text-[13px] font-medium text-[#BFFF00] underline underline-offset-4"
              >codewinoptimizer.com →</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Qué incluye — bench list */}
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <h2
        class="font-[--font-display] font-semibold text-[22px] tracking-[-0.02em] text-white"
      >
        {t("optimizer.section.title")}
      </h2>
      <span
        class="hidden md:inline font-mono text-[11px] tracking-[0.12em] text-[#61697E] uppercase"
        >App · Go + Wails + WebView2</span
      >
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- System Restore -->
      <div class="rounded-[16px] bg-[#111318] border border-[#232730] p-6">
        <div
          class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"
            ><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="8"
            ></circle><path d="M12 3v1M12 20v1M3 12h1M20 12h1"></path></svg
          >
        </div>
        <h3 class="font-semibold text-[15px] text-white">System Restore</h3>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          {t("optimizer.feature.restore.body")}
        </p>
      </div>

      <!-- App Manager -->
      <div class="rounded-[16px] bg-[#111318] border border-[#232730] p-6">
        <div
          class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"
            ><rect x="3" y="3" width="8" height="8" rx="1.5"></rect><rect
              x="13"
              y="3"
              width="8"
              height="8"
              rx="1.5"></rect><rect x="3" y="13" width="8" height="8" rx="1.5"
            ></rect><rect x="13" y="13" width="8" height="8" rx="1.5"
            ></rect></svg
          >
        </div>
        <h3 class="font-semibold text-[15px] text-white">
          App Manager · 181 apps / 8 cats
        </h3>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          {t("optimizer.feature.apps.body")}
        </p>
      </div>

      <!-- Tweaks -->
      <div class="rounded-[16px] bg-[#BFFF00] p-6 text-black">
        <div
          class="w-9 h-9 rounded-[10px] bg-black flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#BFFF00"
            stroke-width="1.6"
            ><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path
              d="M19.4 15a1.6 1.6 0 0 0 .3 1.7l.1.2a1 1 0 0 1-1.4 1.4l-.2-.1a1.6 1.6 0 0 0-1.7-.3 1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0 .3-1.7l-.1-.2a1 1 0 0 1 1.4-1.4l.2.1a1.6 1.6 0 0 0 1.7.3A1.6 1.6 0 0 0 19.4 15Z"
            ></path><path
              d="M4.6 15a1.6 1.6 0 0 1-.3 1.7l-.1.2a1 1 0 0 0 1.4 1.4l.2-.1a1.6 1.6 0 0 1 1.7-.3 1.6 1.6 0 0 1 1-1.5 1.6 1.6 0 0 1-.3-1.7l.1-.2a1 1 0 0 0-1.4-1.4l-.2.1a1.6 1.6 0 0 1-1.7.3A1.6 1.6 0 0 1 4.6 15Z"
            ></path></svg
          >
        </div>
        <h3 class="font-semibold text-[15px]">140+ System Tweaks · 14 cats</h3>
        <p class="mt-2 text-[13px] leading-relaxed opacity-70">
          {t("optimizer.feature.tweaks.body")}
        </p>
      </div>

      <!-- Windows Features -->
      <div class="rounded-[16px] bg-[#111318] border border-[#232730] p-6">
        <div
          class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"
            ><rect x="4" y="4" width="16" height="16" rx="2"></rect><path
              d="M9 9h6M9 12h6M9 15h6"></path></svg
          >
        </div>
        <h3 class="font-semibold text-[15px] text-white">Windows Features</h3>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          {t("optimizer.feature.windows.body")}
        </p>
      </div>

      <!-- Startup Manager -->
      <div class="rounded-[16px] bg-[#111318] border border-[#232730] p-6">
        <div
          class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"
            ><path d="M13 2L4 14h6l-2 8 9-12h-6l2-8Z"></path></svg
          >
        </div>
        <h3 class="font-semibold text-[15px] text-white">Startup Manager</h3>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          {t("optimizer.feature.startup.body")}
        </p>
      </div>

      <!-- System Monitor -->
      <div class="rounded-[16px] bg-[#111318] border border-[#232730] p-6">
        <div
          class="w-9 h-9 rounded-[10px] bg-[#0D0F13] border border-[#232730] flex items-center justify-center mb-4"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"
            ><path d="M3 12h4l2-5 4 10 2-5h6"></path><rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="2"></rect></svg
          >
        </div>
        <h3 class="font-semibold text-[15px] text-white">System Monitor</h3>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          {t("optimizer.feature.monitor.body")}
        </p>
      </div>
    </div>

    <div class="mt-4 grid md:grid-cols-[1.4fr_0.6fr] gap-4">
      <div
        class="rounded-[16px] bg-[#0D0F13] border border-[#232730] p-6 flex gap-4 items-start"
      >
        <div
          class="w-9 h-9 rounded-[10px] bg-[#111318] border border-[#232730] flex items-center justify-center shrink-0"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h10"></path></svg
          >
        </div>
        <div>
          <h3 class="font-semibold text-[15px] text-white">
            {t("optimizer.terminal.title")}
          </h3>
          <p class="mt-1 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("optimizer.terminal.body")}
          </p>
        </div>
      </div>
      <div class="rounded-[16px] border border-[#232730] bg-[#111318] p-6">
        <div
          class="font-mono text-[11px] tracking-[0.08em] text-[#61697E] uppercase"
        >
          {t("optimizer.stack.label")}
        </div>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          Go + Wails v2 · WebView2 · Vanilla JS/CSS · WinGet/Chocolatey ·
          PowerShell/DISM/reg · gopsutil + nvidia-smi
        </p>
      </div>
    </div>
  </section>

  <!-- How to run + antivirus -->
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 pb-10">
    <div class="rounded-[16px] border border-[#232730] bg-[#111318] p-6 md:p-7">
      <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-6">
        <div>
          <h3
            class="font-[--font-display] font-semibold text-[18px] tracking-[-0.01em] text-white"
          >
            {t("optimizer.get_started.title")}
          </h3>
          <ol
            class="mt-4 space-y-3 font-mono text-[13px] leading-relaxed text-[#8B92A8]"
          >
            <li class="flex gap-3">
              <span
                class="w-6 h-6 rounded-full bg-[#BFFF00] text-black flex items-center justify-center text-[12px] font-bold shrink-0"
                >1</span
              >
              {t("optimizer.get_started.step1")}
            </li>
            <li class="flex gap-3">
              <span
                class="w-6 h-6 rounded-full bg-[#111318] border border-[#232730] text-white flex items-center justify-center text-[12px] font-bold shrink-0"
                >2</span
              >
              {t("optimizer.get_started.step2")}
            </li>
            <li class="flex gap-3">
              <span
                class="w-6 h-6 rounded-full bg-[#111318] border border-[#232730] text-white flex items-center justify-center text-[12px] font-bold shrink-0"
                >3</span
              >
              {t("optimizer.get_started.step3")}
            </li>
            <li class="flex gap-3">
              <span
                class="w-6 h-6 rounded-full bg-[#111318] border border-[#232730] text-white flex items-center justify-center text-[12px] font-bold shrink-0"
                >4</span
              >
              {t("optimizer.get_started.step4")}
            </li>
          </ol>
          <p class="mt-4 font-mono text-[11px] text-[#61697E]">
            {t("optimizer.get_started.prereqs")}
          </p>
        </div>
        <div
          class="rounded-[14px] bg-[#FFB020]/[0.06] border border-[#FFB020]/20 p-5"
        >
          <div
            class="font-mono text-[11px] font-bold tracking-[0.08em] text-[#FFB020] uppercase"
          >
            {t("optimizer.av.title")}
          </div>
          <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
            {t("optimizer.av.body1")}<a
              href="https://github.com/oscarxdev/CodeWinOptimizer-App"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 text-white"
              >{t("optimizer.av.link")}</a
            >{t("optimizer.av.body2")}
          </p>
          <div class="mt-4 flex gap-2">
            <a
              href="https://github.com/oscarxdev/CodeWinOptimizer-App/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-[#BFFF00] text-black text-[12px] font-semibold leading-none"
              >Download</a
            >
            <a
              href="https://discord.albionbattlehub.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-[#111318] border border-[#232730] text-white text-[12px] font-medium leading-none"
              >Join KiriHub</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- old categories deprecated -->
    <div
      class="mt-4 rounded-[14px] bg-[#0D0F13] border border-[#232730] px-4 py-3 flex flex-wrap gap-2 items-center justify-between font-mono text-[11px] text-[#61697E]"
    >
      <span>{t("optimizer.deprecated")}</span>
      <a
        href="https://www.codewinoptimizer.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white underline underline-offset-4">codewinoptimizer.com</a
      >
    </div>
  </section>
</BaseLayout>
