---

<BaseLayout title={t("tools.meta_title")}>
  <section class="max-w-[1280px] mx-auto px-4 md:px-6 pt-8 md:pt-10">
    <div
      class="rounded-[20px] bg-[#111318] border border-[#232730] p-6 md:p-10"
    >
      <div
        class="inline-flex items-center gap-2 rounded-full border border-[#232730] bg-[#0D0F13] px-3 py-1.5 mb-5"
      >
        <span class="w-2 h-2 rounded-full bg-[#BFFF00]"></span>
        <span
          class="font-mono text-[11px] tracking-[0.1em] text-[#8B92A8] uppercase"
          >{t("tools.subtitle")}</span
        >
      </div>
      <h1
        class="font-[--font-display] font-bold text-[36px] md:text-[48px] tracking-[-0.03em] leading-[0.9] text-white"
      >
        {t("tools.title")}
      </h1>
      <p class="mt-4 text-[14px] leading-relaxed text-[#8B92A8] max-w-[60ch]">
        {t("tools.hero_sub")}
      </p>
    </div>
  </section>

  <section class="max-w-[1280px] mx-auto px-4 md:px-6 mt-6">
    <div
      class="rounded-[16px] bg-[#0D0F13] border border-[#232730] p-5 md:p-6 flex flex-col md:flex-row gap-6"
    >
      <div class="flex-1">
        <div
          class="font-mono text-[11px] tracking-[0.1em] text-[#61697E] uppercase"
        >
          {t("tools.opensource.eyebrow")}
        </div>
        <p class="mt-2 text-[13px] leading-relaxed text-[#8B92A8]">
          <b class="text-white">⭐ {t("tools.opensource.title")}</b> — {
            t("tools.opensource.description")
          }
        </p>
      </div>
      <div
        class="md:w-[320px] rounded-[12px] bg-[#111318] border border-[#232730] p-4"
      >
        <div class="font-medium text-[13px] text-white">
          {t("tools.opensource.how_to_help")}
        </div>
        <ul class="mt-3 space-y-2 text-[12px] text-[#8B92A8]">
          <li class="flex gap-2">
            <span class="text-[#BFFF00]">1.</span>
            {t("tools.opensource.step1")}
          </li>
          <li class="flex gap-2">
            <span class="text-[#BFFF00]">2.</span>
            {t("tools.opensource.step2")}
          </li>
          <li class="flex gap-2">
            <span class="text-[#BFFF00]">3.</span>
            {t("tools.opensource.step3")}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <main class="max-w-[1280px] mx-auto px-4 md:px-6 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {categories.map((category) => <CategorySection {...category} />)}
    </div>
  </main>
</BaseLayout>
